# Copy to .env and customize when running the HTTP service. Never commit .env.

# Optional shared secret required in the X-API-Key header on /v1/* endpoints
FIREWALL_API_KEY=

# Bind host and port for the HTTP service & Runtime Console
FIREWALL_HOST=127.0.0.1
FIREWALL_PORT=4100

# Hard evaluation latency budget in milliseconds (evaluations exceeding this are flagged)
FIREWALL_MAX_LATENCY_MS=10

# Maximum allowed age of a local DOM / session state snapshot in milliseconds
FIREWALL_MAX_STATE_STALENESS_MS=5000

# Consecutive blocked actions before tripping the runaway-loop circuit breaker
FIREWALL_CIRCUIT_BREAKER_THRESHOLD=5
